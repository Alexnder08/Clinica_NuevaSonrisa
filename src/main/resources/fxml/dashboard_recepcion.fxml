<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.nuevasonrisa.controller.DashboardRecepcionController"
            prefWidth="1200"
            prefHeight="720"
            style="-fx-background-color:#F8FAFC;"
            stylesheets="@../css/dashboard-recepcion.css">

    <left>
        <VBox prefWidth="250"
              spacing="7"
              style="-fx-background-color:#0F172A; -fx-padding:18;">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-tooth" iconSize="26" iconColor="#14B8A6"/>
                <Label text="NUEVA SONRISA"
                       style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            </HBox>

            <Label fx:id="lblUsuario"
                   text="Recepción"
                   wrapText="true"
                   style="-fx-text-fill:#CBD5E1; -fx-font-size:12px;"/>

            <Separator/>

            <Button text=" Inicio" maxWidth="Infinity" onAction="#mostrarInicio" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-home" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Button text=" Servicios" maxWidth="Infinity" onAction="#mostrarServicios" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-tooth" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Button text=" Pacientes" maxWidth="Infinity" onAction="#mostrarPacientes" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-user-injured" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Button text=" Odontólogos" maxWidth="Infinity" onAction="#mostrarOdontologos" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-user-md" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Button text=" Citas" maxWidth="Infinity" onAction="#mostrarCitas" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-calendar-alt" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Button text=" Reportes" maxWidth="Infinity" onAction="#mostrarReportes" styleClass="menu-button">
                <graphic><FontIcon iconLiteral="fas-chart-line" iconSize="15" iconColor="#14B8A6"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text=" Cerrar Sesión" maxWidth="Infinity" onAction="#cerrarSesion" styleClass="logout-button">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="15" iconColor="WHITE"/></graphic>
            </Button>

        </VBox>
    </left>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="lblTitulo"
                   text="Dashboard Recepción"
                   style="-fx-font-size:30px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>

            <StackPane fx:id="contenedorContenido"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color:white;
                              -fx-background-radius:18;
                              -fx-padding:18;
                              -fx-effect:dropshadow(gaussian, rgba(15,23,42,0.12), 16, 0, 0, 5);"/>
        </VBox>
    </center>

</BorderPane>
