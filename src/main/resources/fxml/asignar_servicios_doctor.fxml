<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.AsignarServiciosDoctorController"
      spacing="15"
      prefWidth="450"
      prefHeight="500"
      style="-fx-padding:20;">

    <Label fx:id="lblDoctor"
           style="-fx-font-size:18px;
                  -fx-font-weight:bold;" />

    <Separator />

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS">

        <content>
            <VBox fx:id="contenedorServicios"
                  spacing="8"
                  style="-fx-padding:10;" />
        </content>

    </ScrollPane>

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button text="Guardar"
                onAction="#guardar" />

        <Button text="Cancelar"
                onAction="#cancelar" />

    </HBox>

</VBox>