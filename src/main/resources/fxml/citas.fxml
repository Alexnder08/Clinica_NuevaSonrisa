<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.CitasController"
      spacing="0"
      style="-fx-background-color: #f5f7fa;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fas-calendar-alt"
                  iconSize="28"
                  iconColor="#14B8A6"/>
        <Label text="Citas Dentales"
               style="-fx-font-size:28px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#0F172A;"/>
    </HBox>

    <Label text="Gestión de citas y tratamientos odontológicos"
           style="-fx-font-size:14px; -fx-text-fill:#546e7a; -fx-padding:0 0 15 0;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">

        <TextField fx:id="txtBuscar"
                   promptText="Buscar cita..."
                   prefWidth="280"
                   prefHeight="40"
                   styleClass="campo-busqueda"/>

        <DatePicker fx:id="dpFiltroFecha"
                    prefWidth="150"
                    prefHeight="40"
                    styleClass="date-picker-modern"/>

        <Button text="Filtrar"
                onAction="#filtrarPorFecha"
                prefWidth="120"
                prefHeight="40"
                styleClass="btn-success">

            <graphic>
                <FontIcon iconLiteral="fas-filter"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

        <Button text="Limpiar"
                onAction="#cargarCitas"
                prefWidth="120"
                prefHeight="40"
                styleClass="btn-secondary">

            <graphic>
                <FontIcon iconLiteral="fas-sync"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

        <Button text="Nueva Cita"
                onAction="#nuevaCita"
                prefWidth="140"
                prefHeight="40"
                styleClass="btn-primary">

            <graphic>
                <FontIcon iconLiteral="fas-plus"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

        <Button text="Editar"
                onAction="#editarCita"
                prefWidth="120"
                prefHeight="40"
                styleClass="btn-warning">

            <graphic>
                <FontIcon iconLiteral="fas-edit"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

        <Button text="Cancelar"
                onAction="#cancelarCita"
                prefWidth="130"
                prefHeight="40"
                styleClass="btn-danger">

            <graphic>
                <FontIcon iconLiteral="fas-ban"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

        <Button text="Excel"
                onAction="#exportarCitas"
                prefWidth="120"
                prefHeight="40"
                styleClass="btn-info">

            <graphic>
                <FontIcon iconLiteral="fas-file-excel"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>

        </Button>

    </HBox>

    <TableView fx:id="tablaCitas"
               VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-pref-height: 450;">

        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" sortable="true"/>
            <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="180" sortable="true"/>
            <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="180" sortable="true"/>
            <TableColumn fx:id="colServicio" text="Servicio" prefWidth="180" sortable="true"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120" sortable="true"/>
            <TableColumn fx:id="colHora" text="Hora" prefWidth="100" sortable="true"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" sortable="true"/>
        </columns>
    </TableView>

</VBox>