<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.LoginController"
      prefWidth="1000"
      prefHeight="650"
      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #e3f2fd, #bbdefb);">

    <padding>
        <Insets top="60" right="40" bottom="60" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="25">
        <VBox alignment="CENTER">
            <HBox spacing="8" alignment="CENTER">
                <FontIcon iconLiteral="fas-tooth"
                          iconSize="36"
                          iconColor="#14B8A6"/>
                <Label text="NUEVA SONRISA"
                       style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>
            </HBox>
            <Label text="Sistema de Gestión Dental"
                   style="-fx-font-size:16px; -fx-text-fill:#546e7a;"/>
            <Button text="¿Olvidaste tu contraseña?"
                    onAction="#recuperarPassword"
                    style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-font-size: 13px; -fx-underline: true; -fx-cursor: hand;"/>
        </VBox>

        <VBox spacing="15"
              maxWidth="380"
              style="-fx-background-color: white; -fx-padding: 35 30 35 30; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 14, 0, 0, 4);">

            <Label text="Iniciar Sesión"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>

            <Label text="Usuario" style="-fx-font-size: 13px; -fx-text-fill: #455a64;"/>
            <TextField fx:id="txtUsuario"
                       promptText="Ingrese su usuario"
                       maxWidth="Infinity"
                       style="-fx-pref-height: 42px; -fx-font-size: 14px; -fx-padding: 0 12 0 12; -fx-background-radius: 8; -fx-border-color: #90caf9; -fx-border-radius: 8;"/>

            <Label text="Contraseña" style="-fx-font-size: 13px; -fx-text-fill: #455a64;"/>
            <PasswordField fx:id="txtPassword"
                            promptText="Ingrese su contraseña"
                            maxWidth="Infinity"
                            style="-fx-pref-height: 42px; -fx-font-size: 14px; -fx-padding: 0 12 0 12; -fx-background-radius: 8; -fx-border-color: #90caf9; -fx-border-radius: 8;"/>

            <Label fx:id="lblMensaje"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;"/>

            <Button text="Ingresar"
                    onAction="#iniciarSesion"
                    defaultButton="true"
                    style="-fx-background-color: #0d47a1; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-pref-width: 320; -fx-pref-height: 44; -fx-background-radius: 8;"/>

            <Button text="Cambiar Contraseña"
                    onAction="#cambiarPassword"
                    style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-font-size: 13px; -fx-underline: true; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

</VBox>
