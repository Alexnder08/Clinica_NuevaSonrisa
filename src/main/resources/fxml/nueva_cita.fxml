<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.NuevaCitaController"
      stylesheets="@../css/reserva.css"
      styleClass="reservation-root"
      spacing="0"
      prefWidth="620">

    <VBox styleClass="reservation-header" spacing="8">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane styleClass="header-icon">
                <FontIcon iconLiteral="fas-calendar-check" iconSize="22" iconColor="#0F766E"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Nueva cita dental" styleClass="reservation-title"/>
                <Label text="Completa los datos para reservar la atencion del paciente"
                       styleClass="reservation-subtitle"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="reservation-content" spacing="20">
        <GridPane hgap="18" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="130" halignment="RIGHT"/>
                <ColumnConstraints minWidth="380" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Paciente" styleClass="field-label" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbPaciente" promptText="Selecciona un paciente" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Odontologo" styleClass="field-label" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbDoctor" promptText="Selecciona un odontologo" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Servicio" styleClass="field-label" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cbServicio" promptText="Primero selecciona un odontologo" maxWidth="Infinity"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Fecha y hora" styleClass="field-label" GridPane.rowIndex="3"/>
            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
                <DatePicker fx:id="dpFecha" promptText="Selecciona una fecha" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="cbHora" promptText="Hora" prefWidth="130"/>
            </HBox>

            <Label text="Motivo" styleClass="field-label" GridPane.rowIndex="4"/>
            <TextArea fx:id="txtMotivo" promptText="Describe brevemente el motivo de consulta"
                      prefRowCount="2" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Notas (opcional)" styleClass="field-label" GridPane.rowIndex="5"/>
            <TextArea fx:id="txtNotas" promptText="Puedes agregar indicaciones o antecedentes relevantes"
                      prefRowCount="2" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox styleClass="email-notice" spacing="10" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fas-envelope" iconSize="16" iconColor="#0F766E"/>
            <Label text="Al guardar, enviaremos la confirmacion al correo registrado del paciente."
                   styleClass="email-notice-text" wrapText="true"/>
        </HBox>

        <Label fx:id="lblEstado" styleClass="form-status" wrapText="true"/>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Cancelar" onAction="#cancelar" cancelButton="true" styleClass="button-secondary">
                <graphic><FontIcon iconLiteral="fas-times" iconSize="14" iconColor="#475569"/></graphic>
            </Button>
            <Button fx:id="btnGuardar" text="Confirmar reserva" onAction="#guardar"
                    defaultButton="true" styleClass="button-primary">
                <graphic><FontIcon iconLiteral="fas-check" iconSize="14" iconColor="WHITE"/></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
