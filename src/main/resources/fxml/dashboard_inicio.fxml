<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.nuevasonrisa.controller.DashboardInicioController"
            fitToWidth="true"
            style="-fx-background-color:#F1F5F9;">

    <content>
        <VBox spacing="24">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-chart-line"
                          iconSize="30"
                          iconColor="#14B8A6"/>
                <Label text="Resumen General"
                       style="-fx-font-size:34px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>
            </HBox>

            <HBox spacing="22">

                <VBox minWidth="190" minHeight="115"
                      style="-fx-background-color:linear-gradient(to right,#2563EB,#1D4ED8);
                             -fx-background-radius:18;
                             -fx-padding:22;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15), 15,0,0,4);">
                    <Label text="Pacientes" style="-fx-font-size:14px; -fx-text-fill:#DBEAFE;"/>
                    <Label fx:id="lblPacientes" text="0"
                           style="-fx-font-size:42px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                </VBox>

                <VBox minWidth="190" minHeight="115"
                      style="-fx-background-color:linear-gradient(to right,#F59E0B,#D97706);
                             -fx-background-radius:18;
                             -fx-padding:22;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15), 15,0,0,4);">
                    <Label text="Pendientes" style="-fx-font-size:14px; -fx-text-fill:#FEF3C7;"/>
                    <Label fx:id="lblPendientes" text="0"
                           style="-fx-font-size:42px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                </VBox>

                <VBox minWidth="190" minHeight="115"
                      style="-fx-background-color:linear-gradient(to right,#14B8A6,#0D9488);
                             -fx-background-radius:18;
                             -fx-padding:22;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15), 15,0,0,4);">
                    <Label text="Citas Hoy" style="-fx-font-size:14px; -fx-text-fill:#CCFBF1;"/>
                    <Label fx:id="lblHoy" text="0"
                           style="-fx-font-size:42px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                </VBox>

                <VBox minWidth="190" minHeight="115"
                      style="-fx-background-color:linear-gradient(to right,#8B5CF6,#7C3AED);
                             -fx-background-radius:18;
                             -fx-padding:22;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.15), 15,0,0,4);">
                    <Label text="Odontólogos" style="-fx-font-size:14px; -fx-text-fill:#EDE9FE;"/>
                    <Label fx:id="lblOdontologos" text="0"
                           style="-fx-font-size:42px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                </VBox>

            </HBox>

            <Separator/>

            <VBox spacing="12">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-clipboard-list"
                              iconSize="22"
                              iconColor="#14B8A6"/>
                    <Label text="Últimas acciones"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>
                </HBox>

                <TableView fx:id="tablaAuditoria" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="130"/>
                        <TableColumn fx:id="colAccion" text="Acción" prefWidth="130"/>
                        <TableColumn fx:id="colModulo" text="Módulo" prefWidth="150"/>
                        <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="370"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-calendar-alt"
                              iconSize="22"
                              iconColor="#14B8A6"/>
                    <Label text="Citas de Hoy"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>
                </HBox>

                <TableView fx:id="tablaCitasHoy" prefHeight="230">
                    <columns>
                        <TableColumn fx:id="colPacienteHoy" text="Paciente" prefWidth="240"/>
                        <TableColumn fx:id="colHoraHoy" text="Hora" prefWidth="110"/>
                        <TableColumn fx:id="colDoctorHoy" text="Doctor" prefWidth="240"/>
                        <TableColumn fx:id="colEstadoHoy" text="Estado" prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
