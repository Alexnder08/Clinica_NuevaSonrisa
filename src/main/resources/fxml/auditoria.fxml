<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.AuditoriaController"
      spacing="15"
      style="-fx-background-color: #f5f7fa;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fas-clipboard-list"
                  iconSize="28"
                  iconColor="#14B8A6"/>
        <Label text="Historial de Auditoría"
               style="-fx-font-size:28px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#0F172A;"/>
    </HBox>

    <Label text="Registro de actividades del sistema"
           style="-fx-font-size:13px; -fx-text-fill:#546e7a; -fx-padding:0 0 15 0;"/>

    <TableView fx:id="tablaAuditoria"
               VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-pref-height: 450;">

        <columns>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="140" sortable="true"/>
            <TableColumn fx:id="colAccion" text="Acción" prefWidth="120" sortable="true"/>
            <TableColumn fx:id="colModulo" text="Módulo" prefWidth="140" sortable="true"/>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="420" sortable="true"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="180" sortable="true"/>
        </columns>
    </TableView>

</VBox>