<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.nuevasonrisa.controller.CambiarPasswordController"
      spacing="15"
      prefWidth="400"
      alignment="CENTER"
      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12;">

    <HBox spacing="10" alignment="CENTER">
        <FontIcon iconLiteral="fas-key"
                  iconSize="28"
                  iconColor="#14B8A6"/>
        <Label text="Cambiar Contraseña"
               style="-fx-font-size:24px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#0F172A;"/>
    </HBox>

    <Label text="Actualice su credencial de acceso"
           style="-fx-font-size:13px; -fx-text-fill:#546e7a; -fx-padding:0 0 15 0;"/>

    <TextField fx:id="txtUsuario"
               promptText="Usuario"
               maxWidth="Infinity"/>

    <PasswordField fx:id="txtActual"
                 promptText="Contraseña actual"
                 maxWidth="Infinity"/>

    <PasswordField fx:id="txtNueva"
                 promptText="Nueva contraseña"
                 maxWidth="Infinity"/>

    <PasswordField fx:id="txtConfirmar"
                 promptText="Confirmar nueva contraseña"
                 maxWidth="Infinity"/>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Guardar"
                onAction="#guardar"
                defaultButton="true"
                style="-fx-background-color:#14B8A6;
               -fx-text-fill:white;
               -fx-font-weight:bold;
               -fx-background-radius:10;">
            <graphic>
                <FontIcon iconLiteral="fas-save"
                          iconSize="14"
                          iconColor="WHITE"/>
            </graphic>
        </Button>
    </HBox>

</VBox>