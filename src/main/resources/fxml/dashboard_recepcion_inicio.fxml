<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.nuevasonrisa.controller.DashboardRecepcionInicioController"
            fitToWidth="true"
            style="-fx-background-color: #f5f7fa;">

    <content>
        <VBox spacing="20">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fas-chart-line"
                  iconSize="28"
                  iconColor="#14B8A6"/>
        <Label text="Dashboard de Recepción"
               style="-fx-font-size:28px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#0F172A;"/>
    </HBox>

    <Label text="Resumen de actividad para hoy"
           style="-fx-font-size:13px; -fx-text-fill:#546e7a; -fx-padding:0 0 15 0;"/>

            <HBox spacing="20">
                <VBox minWidth="200"
                      minHeight="120"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1e88e5, #0d47a1); -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Citas Hoy"
                           style="-fx-font-size: 14px; -fx-text-fill: #bbdefb;"/>
                    <Label fx:id="lblCitasHoy"
                           text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox minWidth="200"
                      minHeight="120"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ffb74d, #f57c00); -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Pendientes"
                           style="-fx-font-size: 14px; -fx-text-fill: #ffe0b2;"/>
                    <Label fx:id="lblPendientes"
                           text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox minWidth="200"
                      minHeight="120"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #69f0ae, #00c853); -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Realizadas"
                           style="-fx-font-size: 14px; -fx-text-fill: #b9f6ca;"/>
                    <Label fx:id="lblRealizadasHoy"
                           text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox minWidth="200"
                      minHeight="120"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ff8a65, #e65100); -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Canceladas"
                           style="-fx-font-size: 14px; -fx-text-fill: #ffe0b2;"/>
                    <Label fx:id="lblCanceladasHoy"
                           text="0"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #e0e0e0; -fx-pref-height: 1;"/>

            <VBox spacing="15">
                <Label text="Citas del Día"
                       style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#0F172A;"/>

                <TableView fx:id="tablaCitasDia"
                           prefHeight="380"
                           style="-fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">

                    <columns>
                        <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="220" sortable="true"/>
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="100" sortable="true"/>
                        <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="220" sortable="true"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="140" sortable="true"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </content>

</ScrollPane>